# MongoDB Atlas Connection String
# Replace with your own MongoDB Atlas URI
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGO_URI=

# Dialogflow (Member 3)
# Only required for the Dialogflow bot path. GOOGLE_APPLICATION_CREDENTIALS must
# point at a GCP service account key file — never commit the actual key file
# (already covered by .gitignore).
DIALOGFLOW_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=./path-to-your-service-account-key.json
